    {
      "page_id": "f06",
      "index": 6,
      "source_sha256": "c58aa06bdfb3b5088ef3041c65912849cb83a8bd186115079b601ee6e088dd18",
      "width": 2500,
      "height": 2302,
      "official_label": "pp. [8]-[9]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/394b5495-ba1e-4a80-8510-f528c3c0740c.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/394b5495-ba1e-4a80-8510-f528c3c0740c/full/2500,/0/default.jpg",
      "layout_note": "影像與物理面對照：p8 right + p9 left。單位按物理面右至左及原固定欄序排列；有明確觀察的版心題字與頁碼另列於各面欄文之後，不視為正文續句；未見字不補。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "AI-initial-transcription-unreviewed",
        "later-library-marks": "excluded-described-only"
      },
      "units": [
        {
          "id": "p08-c01",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "種痘一道不留痘漿、固不能傳種別人、不",
          "bbox": null
        },
        {
          "id": "p08-c02",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "善留痘漿亦不能隨時接續、其法莫善於",
          "bbox": null
        },
        {
          "id": "p08-c03",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "用一玻璃小筒長約二寸餘、其管口以極",
          "bbox": null
        },
        {
          "id": "p08-c04",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "細為妙、遂向滿漿之童子、小心以刀尖刺",
          "bbox": null
        },
        {
          "id": "p08-c05",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "破其痘然後將此玻璃小筒輕輕印之、其",
          "bbox": null
        },
        {
          "id": "p08-c06",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "漿自然入於管內、至於痘漿多少不一、惟",
          "bbox": null
        },
        {
          "id": "p08-c07",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "擇壯旺者佳、總之每一玻璃小筒以裝一",
          "bbox": null
        },
        {
          "id": "p08-c08",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "小半為度、待痘漿入後、遂打橫向燈火輕",
          "bbox": null
        },
        {
          "id": "p08-c09",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "輕煖之、但不可煖正其漿、煖後卽以指捂",
          "bbox": null
        },
        {
          "id": "p08-running-title",
          "layer": "original-print",
          "role": "running-title",
          "side": "right",
          "text": "種痘",
          "bbox": null
        },
        {
          "id": "p08-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "right",
          "text": "三",
          "bbox": null
        },
        {
          "id": "p09-c01",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "住不近漿之一頭、其漿自然乘火氣而行",
          "bbox": null
        },
        {
          "id": "p09-c02",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "以行到中間為妥、如果行到中間、卽將燈",
          "bbox": null
        },
        {
          "id": "p09-c03",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "火燒鎔兩頭令其埋口、倘或不到中間、其",
          "bbox": null
        },
        {
          "id": "p09-c04",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "不近漿之一頭、仍用火埋口、其近漿之一",
          "bbox": null
        },
        {
          "id": "p09-c05",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "頭、則另用蠟封口、如此則痘漿方不洩氣",
          "bbox": null
        },
        {
          "id": "p09-c06",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "亦不致壞、大約雖兩三載亦可用也、臨用",
          "bbox": null
        },
        {
          "id": "p09-c07",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "時、打開兩頭、用口吹出以碟盛之、卽能取",
          "bbox": null
        },
        {
          "id": "p09-c08",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "漿傳種、豈不便捷、依此法多為預備、自可",
          "bbox": null
        },
        {
          "id": "p09-c09",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "隨時濟人、非所謂盡美盡善歟",
          "bbox": null
        },
        {
          "id": "p09-running-title",
          "layer": "original-print",
          "role": "running-title",
          "side": "left",
          "text": "種痘捷法",
          "bbox": null
        },
        {
          "id": "p09-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "left",
          "text": "四",
          "bbox": null
        }
      ],
      "uncertainties": []
    },
