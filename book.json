    {
      "page_id": "f03",
      "index": 3,
      "source_sha256": "9b80bc24fd622a9d183ab4623a5739ff6592cc0342963f229ae6d2a5d1522d62",
      "width": 2500,
      "height": 2302,
      "official_label": "pp. [2]-[3]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/3f7cd8bd-e1f0-462d-99e9-59a78cc99b88.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/3f7cd8bd-e1f0-462d-99e9-59a78cc99b88/full/2500,/0/default.jpg",
      "layout_note": "影像與物理面對照：p2 bleedthrough at right + p3 at left。右側p02為題頁透印，不重錄為另一份正文；左側p03有歷史印刷文字。單位按物理面右至左及原固定欄序排列；有明確觀察的版心題字與頁碼另列於各面欄文之後，不視為正文續句；未見字不補。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "AI-initial-transcription-unreviewed",
        "later-library-marks": "excluded-described-only"
      },
      "units": [
        {
          "id": "p03-c01",
          "layer": "original-print",
          "role": "title",
          "side": "left",
          "text": "種痘論",
          "bbox": null
        },
        {
          "id": "p03-c02",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "種痘之法、多在手臂上約寸餘步仿用尖",
          "bbox": null
        },
        {
          "id": "p03-c03",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "利刀仔、或用針、輕輕挑破皮左右每兩三",
          "bbox": null
        },
        {
          "id": "p03-c04",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "處、以不見血流為妙、再用刀尖染些痘漿",
          "bbox": null
        },
        {
          "id": "p03-c05",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "搽在挑破處、倘若手重、挑皮深破、待息間",
          "bbox": null
        },
        {
          "id": "p03-c06",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "血止、然後染漿種入、此一法也、更有不用",
          "bbox": null
        },
        {
          "id": "p03-c07",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "先挑破皮、卽將刀尖染痘漿、每粒處輕輕",
          "bbox": null
        },
        {
          "id": "p03-c08",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "刺五六點、其漿自然從所刺之處種入、此",
          "bbox": null
        },
        {
          "id": "p03-c09",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "法較為簡捷、種期必以七日至九日為準、",
          "bbox": null
        },
        {
          "id": "p03-running-title",
          "layer": "original-print",
          "role": "running-title",
          "side": "left",
          "text": "種痘捷法",
          "bbox": null
        },
        {
          "id": "p03-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "left",
          "text": "一",
          "bbox": null
        }
      ],
      "uncertainties": [
        {
          "id": "unc-001",
          "unit_id": "p03-c02",
