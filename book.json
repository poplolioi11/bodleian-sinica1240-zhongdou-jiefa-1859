    {
      "page_id": "f05",
      "index": 5,
      "source_sha256": "bb32643cac3f51ba27a174b59639dc24e6660207b56555e64561bda5053d5f00",
      "width": 2500,
      "height": 2302,
      "official_label": "pp. [6]-[7]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/2f1a12ef-6d9b-4353-80bd-608f79ae98f8.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/2f1a12ef-6d9b-4353-80bd-608f79ae98f8/full/2500,/0/default.jpg",
      "layout_note": "影像與物理面對照：p6 right + p7 left。單位按物理面右至左及原固定欄序排列；有明確觀察的版心題字與頁碼另列於各面欄文之後，不視為正文續句；未見字不補。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "AI-initial-transcription-unreviewed",
        "later-library-marks": "excluded-described-only"
      },
      "units": [
        {
          "id": "p06-c01",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "漿傳種別人、出一粒者可傳種幾人、出兩",
          "bbox": null
        },
        {
          "id": "p06-c02",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "三粒者可傳種多人、唐人不肯將痘漿傳",
          "bbox": null
        },
        {
          "id": "p06-c03",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "種別人、且又種痘獨趂春暖時候、天冷天",
          "bbox": null
        },
        {
          "id": "p06-c04",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "熱、俱少人種、是以痘漿不能接續、必待外",
          "bbox": null
        },
        {
          "id": "p06-c05",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "國帶來、始有得用、其實不必定用痘漿、痘",
          "bbox": null
        },
        {
          "id": "p06-c06",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "痂亦可用、留痂之法、將小兒所落痘痂用",
          "bbox": null
        },
        {
          "id": "p06-c07",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "錫箔包固、銅箔亦可再用紙包、外用蠟兩",
          "bbox": null
        },
        {
          "id": "p06-c08",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "塊合埋、密其合口、勿令發壞、雖兩三年可",
          "bbox": null
        },
        {
          "id": "p06-c09",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "用、臨用時取出的用水濕透調勻便可作",
          "bbox": null
        },
        {
          "id": "p06-running-title",
          "layer": "original-print",
          "role": "running-title",
          "side": "right",
          "text": "種痘捷法",
          "bbox": null
        },
        {
          "id": "p06-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "right",
          "text": "二",
          "bbox": null
        },
        {
          "id": "p07-c01",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "痘漿用、如此家家明曉、藏好痘痂依佢種",
          "bbox": null
        },
        {
          "id": "p07-c02",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "法、自己便能與子女傳種、不須外國帶來",
          "bbox": null
        },
        {
          "id": "p07-c03",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "痘漿、又不須費銀延請醫士、豈不甚便、余",
          "bbox": null
        },
        {
          "id": "p07-c04",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "來粵東贈醫各症、兼贈種痘、每見貧人苦",
          "bbox": null
        },
        {
          "id": "p07-c05",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "於無貲難求醫士、以致虛延數歲猶有未",
          "bbox": null
        },
        {
          "id": "p07-c06",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "種者、偶遇痘症時行甚為可慮、茲將種痘",
          "bbox": null
        },
        {
          "id": "p07-c07",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "捷法、刋送廣傳、俾遠近皆明種法、不用求",
          "bbox": null
        },
        {
          "id": "p07-c08",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "人、及早自種、可以無虞痘患、是所厚望也",
          "bbox": null
        },
        {
          "id": "p07-c09",
          "layer": "original-print",
          "role": "title",
          "side": "left",
          "text": "留痘漿妙法",
          "bbox": null
        },
        {
          "id": "p07-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "left",
          "text": "三",
          "bbox": null
        }
      ],
      "uncertainties": [
        {
          "id": "unc-004",
          "unit_id": "p07-c01",
