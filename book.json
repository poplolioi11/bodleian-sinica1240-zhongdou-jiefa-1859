    {
      "page_id": "f03",
      "index": 3,
      "source_sha256": "9b80bc24fd622a9d183ab4623a5739ff6592cc0342963f229ae6d2a5d1522d62",
      "width": 2500,
      "height": 2302,
      "official_label": "pp. [2]-[3]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/3f7cd8bd-e1f0-462d-99e9-59a78cc99b88.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/3f7cd8bd-e1f0-462d-99e9-59a78cc99b88/full/2500,/0/default.jpg",
      "layout_note": "影像與物理面對照：p2 bleedthrough at right + p3 at left。右側p02為題頁透印，不重錄為另一份正文；左側p03有歷史印刷文字。單位按物理面右至左及原固定欄序排列；有明確觀察的版心題字與頁碼另列於各面欄文之後，不視為正文續句；未見字不補。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "AI-independent-reading-and-controller-adjudication",
        "later-library-marks": "excluded-described-only"
      },
      "units": [
        {
          "id": "p03-c01",
          "layer": "original-print",
          "role": "title",
          "side": "left",
          "text": "種痘論",
          "bbox": null
        },
        {
          "id": "p03-c02",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "種痘之法、多在手臂上約寸餘步位、用尖",
          "bbox": null
        },
        {
          "id": "p03-c03",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "利、刀仔、或用針、輕輕挑破皮、左右每兩三",
          "bbox": null
        },
        {
          "id": "p03-c04",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "處、以不見血流為妙、再用刀尖、染些痘漿",
          "bbox": null
        },
        {
          "id": "p03-c05",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "搽在挑破處、倘若手重、挑皮深破、待息間",
          "bbox": null
        },
        {
          "id": "p03-c06",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "血止、然後染漿種入、此一法也、更有不用",
          "bbox": null
        },
        {
          "id": "p03-c07",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "先挑破皮、卽將刀尖染痘漿、每粒處輕輕",
          "bbox": null
        },
        {
          "id": "p03-c08",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "刺五六點其漿自然從所刺之處種入、此",
          "bbox": null
        },
        {
          "id": "p03-c09",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "法較為簡捷、種期必以七日至九日為準、",
          "bbox": null
        },
        {
          "id": "p03-running-title",
          "layer": "original-print",
          "role": "running-title",
          "side": "left",
          "text": "種痘捷法",
          "bbox": null
        },
        {
          "id": "p03-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "left",
          "text": "一",
          "bbox": null
        }
      ],
      "uncertainties": []
    },
    {
      "page_id": "f04",
      "index": 4,
      "source_sha256": "535ba882ab11078cf86e6595d1c40b88d1440ef5a7615fb075f7ffa932f6aee7",
      "width": 2500,
      "height": 2302,
      "official_label": "pp. [4]-[5]",
      "canvas_id": "https://iiif.bodleian.ox.ac.uk/iiif/canvas/00c471fd-cddb-4816-a0e6-5cf77ca15961.json",
      "image_url": "https://iiif.bodleian.ox.ac.uk/iiif/image/00c471fd-cddb-4816-a0e6-5cf77ca15961/full/2500,/0/default.jpg",
      "layout_note": "影像與物理面對照：p4 right + p5 left。單位按物理面右至左及原固定欄序排列；有明確觀察的版心題字與頁碼另列於各面欄文之後，不視為正文續句；未見字不補。",
      "layout_reviewed": true,
      "layer_states": {
        "original-print": "AI-independent-reading-and-controller-adjudication",
        "later-library-marks": "excluded-described-only"
      },
      "units": [
        {
          "id": "p04-c01",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "因所種者、必俟七八日然後滿漿、漿滿方",
          "bbox": null
        },
        {
          "id": "p04-c02",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "能傳種別人、旣種之後、兩三日間、見有紅",
          "bbox": null
        },
        {
          "id": "p04-c03",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "點似蚊口、四五日間漸漸起小泡、八日然",
          "bbox": null
        },
        {
          "id": "p04-c04",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "後滿漿、其色畧黃、似珍珠、四圍根脚有紅",
          "bbox": null
        },
        {
          "id": "p04-c05",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "線圍任九日十日至紅、周圍堅硬、畧有些",
          "bbox": null
        },
        {
          "id": "p04-c06",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "腫、十一日漸消、中間先變白色、然後結靨、",
          "bbox": null
        },
        {
          "id": "p04-c07",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "十四日至十八日、然後掃靨、掃靨後有痘",
          "bbox": null
        },
        {
          "id": "p04-c08",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "疼、凡小兒種痘、最好是出世後百日牛歲",
          "bbox": null
        },
        {
          "id": "p04-c09",
          "layer": "original-print",
          "role": "body",
          "side": "right",
          "text": "之間、惟出牙之時、身體不甚自在、不宜種、",
          "bbox": null
        },
        {
          "id": "p04-running-title",
          "layer": "original-print",
          "role": "running-title",
          "side": "right",
          "text": "種痘捷法",
          "bbox": null
        },
        {
          "id": "p04-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "right",
          "text": "一",
          "bbox": null
        },
        {
          "id": "p05-c01",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "或身體有別樣病痛、亦不宜種、種後必出、",
          "bbox": null
        },
        {
          "id": "p05-c02",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "或有時種不合法、其漿不能種入、故痘不",
          "bbox": null
        },
        {
          "id": "p05-c03",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "出者有之、須多次種之、以種至必出為止、",
          "bbox": null
        },
        {
          "id": "p05-c04",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "大抵旣種之後、身體必有些發熱、然後灌",
          "bbox": null
        },
        {
          "id": "p05-c05",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "漿、漿滿後、仍覺身體不安、穿着衣服、最要",
          "bbox": null
        },
        {
          "id": "p05-c06",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "小心、勿令擦破、倘擦破、見有熱痛、用牛乳",
          "bbox": null
        },
        {
          "id": "p05-c07",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "或粥渣、貼之自愈、痘漿最要揀擇瘋疾者",
          "bbox": null
        },
        {
          "id": "p05-c08",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "固不取用、虛弱者亦不取用、種時揀擇好",
          "bbox": null
        },
        {
          "id": "p05-c09",
          "layer": "original-print",
          "role": "body",
          "side": "left",
          "text": "漿、種了一人之後、至八日漿滿、可將此人痘",
          "bbox": null
        },
        {
          "id": "p05-running-title",
          "layer": "original-print",
          "role": "running-title",
          "side": "left",
          "text": "種痘捷法",
          "bbox": null
        },
        {
          "id": "p05-printed-page-number",
          "layer": "original-print",
          "role": "printed-page-number",
          "side": "left",
          "text": "二",
          "bbox": null
        }
      ],
